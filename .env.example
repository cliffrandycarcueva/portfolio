# Copy to .env. Use one hostname consistently in your browser.
PUBLIC_ORIGIN=http://localhost:5173
API_PORT=3001
API_HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=portfolio
# Run npm run pin:hash and paste its output here. Never put a PIN in browser code.
OWNER_PIN_HASH=
OWNER_EMAIL=you@example.com
# Development only: verification codes and notifications print in the API terminal.
MAIL_MODE=console
# Production: MAIL_MODE=resend, NODE_ENV=production, HTTPS PUBLIC_ORIGIN,
# and real credentials below. Set API_HOST=0.0.0.0 in a container.
RESEND_API_KEY=
MAIL_FROM=
# Only when deployed behind a known reverse proxy; match its exact hop count.
TRUST_PROXY_HOPS=0
