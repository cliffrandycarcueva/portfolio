# Copy to .env. Use one hostname consistently in your browser.
PUBLIC_ORIGIN=http://localhost:5173
API_PORT=3001
API_HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=portfolio
# Run npm run pin:hash and paste its output here. Never put a PIN in browser code.
OWNER_PIN_HASH=
# No email provider or sender domain is required.
# Vercel enables MongoDB change streams automatically. For other multi-instance
# deployments, set REALTIME_MODE=database and use Atlas or a MongoDB replica set.
# REALTIME_MODE=database
# Production: NODE_ENV=production and HTTPS PUBLIC_ORIGIN.
# Set API_HOST=0.0.0.0 in a container.
# Only when deployed behind a known reverse proxy; match its exact hop count.
TRUST_PROXY_HOPS=0
