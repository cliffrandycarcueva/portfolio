{
  "name": "cliff-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/clean-build.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:react && npm run build:angular && node scripts/finalize-build.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:react": "vite",
    "dev:angular": "ng serve",
    "build:react": "tsc -b && vite build",
    "build:angular": "ng build",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "dev:api": "npm run build:api && node --watch apps/api/build/main.js",
    "dev:full": "npm run build:api && node scripts/dev.mjs --api",
    "start": "node apps/api/build/main.js",
    "build:full": "npm run build && npm run build:api",
    "pin:hash": "node scripts/hash-pin.mjs",
    "test:api": "npm run build:api && node --test apps/api/test/*.test.mjs"
  },
  "dependencies": {
    "@angular/common": "^21.2.24",
    "@angular/compiler": "^21.2.24",
    "@angular/core": "^21.2.24",
    "@angular/platform-browser": "^21.2.24",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.21.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.24",
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "latest"
  }
}
