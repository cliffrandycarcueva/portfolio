{
  "framework": null,
  "buildCommand": "npm run build:full",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/react/", "permanent": false },
    { "source": "/react", "destination": "/react/", "permanent": false },
    { "source": "/angular", "destination": "/angular/", "permanent": false }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "apps/api/{build/**,package.json}"
    }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index" }]
}
